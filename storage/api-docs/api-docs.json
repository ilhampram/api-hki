            },
            "post": {
                "tags": [
                    "Documents"
                ],
                "summary": "Tambah Dokumen HKI",
                "operationId": "9b247d60e8834d470666fba8e773edb4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nomor_hki": {
                                        "type": "string",
                                        "example": "HKI001"
                                    },
                                    "judul": {
                                        "type": "string",
                                        "example": "Sistem Inventaris HKI"
                                    },
                                    "pemilik": {
                                        "type": "string",
                                        "example": "UNPAM"
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "tanggal_daftar": {
                                        "type": "string",
                                        "example": "2026-07-11"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "Pending"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Dokumen berhasil ditambahkan"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
